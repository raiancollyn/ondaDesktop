{
  "name": "onda-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Onda",
  "repository": {
    "type": "git",
    "url": "https://github.com/raiancollyn/ondaDesktop.git"
  },
  "description": "Aplicativo desktop do Onda: shell Electron para o site Blazor com captura nativa no Windows.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start-electron.cjs",
    "start:local": "node scripts/start-electron.cjs --local",
    "native:build": "dotnet build native/OndaCapture/OndaCapture.csproj -c Release",
    "native:publish": "dotnet publish native/OndaCapture/OndaCapture.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -o native-dist",
    "pack": "npm run native:publish && electron-builder --win dir",
    "dist": "npm run native:publish && electron-builder --win nsis",
    "dist:zip": "npm run native:publish && electron-builder --win zip",
    "dist:nsis": "npm run native:publish && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "net.dpbr.onda",
    "productName": "Onda",
    "copyright": "Onda",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "picker/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native-dist",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "installer",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Onda",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Onda-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onda",
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "Onda",
        "schemes": [
          "onda"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "raiancollyn",
        "repo": "ondaDesktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
